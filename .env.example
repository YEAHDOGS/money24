# Copy to .env (never commit .env). Read by docker compose.
# SEC and BLS reject requests until this includes a contact email.
USER_AGENT=Money24-News/0.1 (DOGS; contact@example.com)
# Set on a server: guards PUT /api/settings.
NEWSD_ADMIN_TOKEN=
# Callers send it to m24d as "Authorization: Bearer <secret>". Leave empty and m24d generates a
# random one in its data folder; if you set it, use at least 16 random characters.
M24D_WEBHOOK_SECRET=
# Live quotes for m24d from Webull OpenAPI (optional). Without them, trades use the called price.
# Get a key in the Webull Developer Console; start with a paperTrade (sandbox) key.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# sandbox (default) or production
WEBULL_ENV=sandbox
# Only for apps with 2FA turned on (the production default)
WEBULL_ACCESS_TOKEN=
# AI providers for play analysis (optional; add any you use). Keys stay on this machine: m24d sends
# each one only to its own provider and never to the browser. Without one, plays still work and are
# still traded; you just get no AI read.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
# Model overrides. Defaults: claude-opus-5-5, gpt-5.1, grok-4, gemini-2.5-flash.
M24D_ANTHROPIC_MODEL=
M24D_OPENAI_MODEL=
M24D_XAI_MODEL=
M24D_GEMINI_MODEL=
# Local AI through Ollama (optional, no key, nothing leaves the machine). Set either line to use it; with
# neither, m24d never calls Ollama. OLLAMA_HOST is Ollama's own variable: an address such as 0.0.0.0:11434
# works and is reached on 127.0.0.1. Default http://127.0.0.1:11434 and gpt-oss:20b (see notes/ai-bakeoff.md
# for which local model does which job). Cloud providers with a key are asked first; when Ollama is down
# it shows as not connected and plays get no local read.
# OLLAMA_HOST=http://127.0.0.1:11434
# M24D_OLLAMA_MODEL=gpt-oss:20b
# Thinking level: low (default, quickest), medium or high for gpt-oss; true or false for qwen.
# M24D_OLLAMA_THINK=low
# DOGS AI's finance worker (FinBERT sentiment, Kronos/Chronos/TimesFM forecasts) is found through the
# server.json DOGS AI writes in its data folder. Set this only to reach one somewhere else.
# M24D_DOGS_AI=http://127.0.0.1:8788
# Where m24d reads headlines for a play's symbol (newsd). Default http://127.0.0.1:8024
M24D_NEWSD=
# Around the clock (npm run forever, docs/RUNNING.md). Only for a tunnel that publishes a hostname of its
# own; the desk at money24.dogs.red/desk/ goes through Workers VPC and needs none.
M24D_PUBLIC_HOST=
# The tunnel's token (the tunnel "money24": Zero Trust -> Networks -> Tunnels -> install command). With it the
# supervisor runs cloudflared as a third service and restarts it like the others. Secret: .env only.
M24D_TUNNEL_TOKEN=
# Where cloudflared is, when it is not in its usual place (Windows: C:/Program Files (x86)/cloudflared).
# M24D_CLOUDFLARED=
# Replaces the flags the supervisor gives m24d (default: --web .run/web --keep-awake). Space-separated.
# M24D_ARGS=--web .run/web

# Alpaca: the broker Money 24 places orders with (stocks, ETFs, options, crypto). Use the PAPER keys
# first: dashboard -> switch to the Paper account -> API Keys -> Generate. Paper and live keys differ.
# The keys stay on this machine; the runner sends them only to Alpaca and never to the browser.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# paper (default) or live. Live is refused until a desk has cleared the go-live bar.
ALPACA_ENV=paper
# Market data feed: iex (free, real-time from one exchange) or sip (all exchanges, paid plan).
ALPACA_DATA_FEED=iex

# Kalshi: prediction markets. The prediction desk (the Odds tab) needs NO key: it reads Kalshi's public
# prices and keeps its own paper book. Keys are only for placing orders on Kalshi later, starting with
# the demo exchange: sign up at demo.kalshi.co (separate from a real account), then Account -> API Keys
# -> Create. Kalshi shows the private key once: save it as a .pem file OUTSIDE this repo, and put its
# path here. The key ID is not secret on its own; the .pem file is.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# demo (default) or live. Demo keys only work on demo, live keys only on live.
KALSHI_ENV=demo
# off turns the prediction desk off.
# M24D_PREDICT=off
# off disables live polling of Telegram and Reddit public pages.
# M24D_PUBLIC_FOLLOW=off

# Telegram user API. Create an app at https://my.telegram.org under API development tools.
# Use the numeric api_id, api_hash and your phone in international format.
# Run m24d --telegram-login once with the runner's data path. See engine/README.md.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Discord Developer Portal > Applications > Bot. Enable Message Content Intent and invite
# the bot to the server with View Channel and Read Message History. For a server you do
# not run, use Follow on an Announcement Channel and point the bot at your receiving channel.
DISCORD_BOT_TOKEN=
# Extra bots use per-source token_env. Example: "token_env":"DISCORD_ALERTS_BOT_TOKEN".
# DISCORD_ALERTS_BOT_TOKEN=

# Optional network checks against channels you have permission to read.
# M24D_LIVE=1
# M24D_LIVE_TELEGRAM_CHANNEL=
# M24D_LIVE_TELEGRAM_DATA=
# M24D_LIVE_DISCORD_CHANNEL=
