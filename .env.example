# Copy to .env (never commit .env). Read by docker compose.
# SEC and BLS reject requests until this includes a contact email.
USER_AGENT=Money24-News/0.1 (DOGS; contact@example.com)
# Set on a server: guards PUT /api/settings.
NEWSD_ADMIN_TOKEN=
# Callers send it to m24d as "Authorization: Bearer <secret>". Leave empty and m24d generates a
# random one in its data folder; if you set it, use at least 16 random characters.
M24D_WEBHOOK_SECRET=
# Live quotes for m24d from Webull OpenAPI (optional). Without them, paper trades use the called price.
# Get a key in the Webull Developer Console; start with a paperTrade (sandbox) key.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# sandbox (default) or production
WEBULL_ENV=sandbox
# Only for apps with 2FA turned on (the production default)
WEBULL_ACCESS_TOKEN=
