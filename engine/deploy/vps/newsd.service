[Unit]
Description=Money 24 news engine
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/money24/.ready

[Service]
User=money24
EnvironmentFile=/etc/money24.env
Environment=GOMEMLIMIT=160MiB
ExecStart=/opt/money24/current/newsd --addr 127.0.0.1:8024 --data /var/lib/money24/data/news
Restart=on-failure
RestartSec=5
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/money24/data
UMask=0077

[Install]
WantedBy=multi-user.target
