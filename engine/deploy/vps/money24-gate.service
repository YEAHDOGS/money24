[Unit]
Description=Money 24 start gate: free-tier machine under the egress limit
After=network-online.target
Wants=network-online.target

# Every Money 24 service Requires= this unit. When the guard stops it, they stop too;
# when it refuses to start, they do not start. A missing binary also refuses.
[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/money24-guard.env
Environment=GOMEMLIMIT=24MiB
ExecStart=/opt/money24/current/m24guard allow
# Count the last minutes of traffic before a shutdown resets the kernel counters.
ExecStop=/opt/money24/current/m24guard sample
TimeoutStartSec=90
StateDirectory=m24guard
StateDirectoryMode=0755
MemoryMax=48M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
