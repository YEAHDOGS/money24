[Unit]
Description=Money 24 egress and free-tier guard
After=network-online.target
Wants=network-online.target
# Deploy installs the binary; until then there is nothing to guard.
ConditionPathExists=/opt/money24/current/m24guard

[Service]
Type=oneshot
EnvironmentFile=-/etc/money24-guard.env
Environment=GOMEMLIMIT=24MiB
ExecStart=/opt/money24/current/m24guard check
StateDirectory=m24guard
StateDirectoryMode=0755
MemoryMax=48M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
